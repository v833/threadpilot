# bot 注册文件路径；默认读取 config/bots.json
BOTS_CONFIG=config/bots.json

# 飞书凭证变量名由 bots.json 中的 appIdEnv / appSecretEnv 决定
FEISHU_CEO_ASSISTANT_APP_ID=cli_xxx
FEISHU_CEO_ASSISTANT_APP_SECRET=xxx

FEISHU_PRODUCT_APP_ID=cli_xxx
FEISHU_PRODUCT_APP_SECRET=xxx

FEISHU_DEVELOPER_APP_ID=cli_xxx
FEISHU_DEVELOPER_APP_SECRET=xxx

FEISHU_QA_APP_ID=cli_xxx
FEISHU_QA_APP_SECRET=xxx

FEISHU_ASSISTANT_APP_ID=cli_xxx
FEISHU_ASSISTANT_APP_SECRET=xxx

# 测试话题群 chat_id（把 bot 拉进群后获取）
TEST_CHAT_ID=oc_xxx

# 自己的飞书 open_id；先运行机器人并从 sender= 日志中取得
OWNER_OPEN_ID=ou_xxx

# DimAgent 官方 CLI 默认是 dim；仅在使用自定义入口时覆盖
DIMAGENT_COMMAND=

# 兼容旧配置：bot 未填写 workspace 时作为默认项目目录
# 新配置请在 config/bots.json 的每个 bot 上填写 workspace
CLI_WORKDIR=

# 网络代理（可选）：配置后对所有 bot 默认生效（CLI 子进程会继承这些变量）。
# 如需单独覆盖，在 config/bots.json 的对应 bot 上配置 proxy——bot 级配置优先于这里。
# 未配置则保持直连。
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# CLI 单轮执行超时（毫秒）：默认 30 分钟，按引擎变量优先。
# 需要限制时填写正整数；其他插件引擎同样可使用 <ENGINE_ID>_TIMEOUT_MS 覆盖。
CLI_TIMEOUT_MS=
CLAUDE_TIMEOUT_MS=
CODEX_TIMEOUT_MS=

# Claude Code / Codex 的模型后端使用各自的用户级配置管理
# 也可以使用 CC Switch 在不同模型服务之间切换

# ---- Agent 管理页面 (agent-admin 插件) ----
# 管理 API 端口（缺省 3103）与访问令牌（必配；未配置时管理接口拒绝启动）。
# 浏览器/请求需携带请求头 X-Api-Token: <ADMIN_API_TOKEN>。
# 页面与接口监听 127.0.0.1；远程访问请先建 SSH 隧道或 nginx 反代。
ADMIN_API_PORT=3103
ADMIN_API_TOKEN=
