{
  "name": "threadpilot",
  "version": "0.1.3",
  "description": "在飞书话题里，指挥你的 AI 编程团队。",
  "type": "module",
  "bin": {
    "tpl": "dist/index.js",
    "threadpilot": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/probe-*.js",
    "!dist/agents",
    ".agents/skills",
    "config/bots.example.json",
    "cordis.yml",
    "README.md"
  ],
  "scripts": {
    "dev": "pnpm start",
    "start": "tsx watch --include .env --include 'config/*.json' --include 'cordis.yml' src/index.ts",
    "start:once": "tsx src/index.ts",
    "build": "tsc",
    "prepublishOnly": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "test": "node scripts/test-runner.mjs",
    "test:fast": "node scripts/test-runner.mjs --scope fast",
    "test:cli": "node scripts/test-runner.mjs --scope cli",
    "test:plugins": "node scripts/test-runner.mjs --scope plugins",
    "test:serial": "node scripts/test-runner.mjs --serial",
    "probe:cli": "tsx src/probe-cli.ts",
    "probe:tool": "tsx src/probe-app-tool.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.70.0",
    "@agentclientprotocol/sdk": "^1.3.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cordis": "4.0.0-rc.8",
    "croner": "^10.0.1",
    "dotenv": "^17.2.1",
    "node-pty": "^1.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitepress": "^1.6.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1"
}
